		summarizeBy: sum
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	column Day
		dataType: int64
		formatString: 0
		lineageTag: 31d7aa3f-df94-4555-9961-7c0ec3d45869
		summarizeBy: sum
		sourceColumn: Day

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 516a6df6-2a10-4b3f-904c-fc5caeb9a0e1
		summarizeBy: sum
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column 'Year Month' = FORMAT ( Fact_Sales[InvoiceDate], "yyyy-MM" )
		dataType: string
		lineageTag: f6d15a94edc42260b037b34221064ac5
		summarizeBy: none
		sortByColumn: 'Year Month Sort'

	column 'Year Month Sort' = YEAR ( Fact_Sales[InvoiceDate] ) * 100 + MONTH ( Fact_Sales[InvoiceDate] )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7e70285484b274999fcbd7786f434c43
		summarizeBy: none

