table Fact_Sales
	lineageTag: c8dc3d9a-1c81-48c6-96dc-20e60b5097e9

	/// Gross sales from TotalAmount; the source reconciles to Quantity × UnitPrice.
	measure 'Gross Sales Before Discount & Tax' = SUM ( Fact_Sales[TotalAmount] )
		formatString: #,0.00 "EGP"
		lineageTag: 9a2c5b24b38c9cc13d48d8850d302d61

	measure 'Units Sold' = SUM ( Fact_Sales[Quantity] )
		formatString: #,0
		lineageTag: 4ff20b42882dd79fb2a7e1d931d9acf0

	measure 'Distinct Invoices' = DISTINCTCOUNT ( Fact_Sales[InvoiceNo] )
		formatString: #,0
		lineageTag: ac7db8ea9fd55ef93829dc6c3a3eda48

	measure 'Customers with Sales' = DISTINCTCOUNTNOBLANK ( Fact_Sales[CustomerID] )
		formatString: #,0
		lineageTag: 8813bca18b6224b6e1ee86a4dd398eed

	measure 'Products Sold' = DISTINCTCOUNTNOBLANK ( Fact_Sales[ProductID] )
		formatString: #,0
		lineageTag: 83dab8f457e9d4fb1775d574f0c933ac

	measure 'Average Invoice Value' = DIVIDE ( [Gross Sales Before Discount & Tax], [Distinct Invoices] )
		formatString: #,0.00 "EGP"
		lineageTag: 9d034f32d237afd511b5ebd1fff15b2d

	/// Excludes rows without a customer ID; demographics and locations cannot be assigned to those rows.
	measure 'Customer-Linked Gross Sales' = CALCULATE ( [Gross Sales Before Discount & Tax], FILTER ( Fact_Sales, NOT ISBLANK ( Fact_Sales[CustomerID] ) ) )
		formatString: #,0.00 "EGP"
		lineageTag: 1dda282a72878758d9d4e70f2c078627

	measure 'Customer-Linked Invoices' = CALCULATE ( [Distinct Invoices], FILTER ( Fact_Sales, NOT ISBLANK ( Fact_Sales[CustomerID] ) ) )
		formatString: #,0
		lineageTag: 09445fc8914b2f4642e317d556ead258

	measure 'Customer-Linked Average Invoice Value' = DIVIDE ( [Customer-Linked Gross Sales], [Customer-Linked Invoices] )
		formatString: #,0.00 "EGP"
		lineageTag: 4f7771ff31377560757a82c7acae4325

	measure 'Customer-Linked Units Sold' = CALCULATE ( [Units Sold], FILTER ( Fact_Sales, NOT ISBLANK ( Fact_Sales[CustomerID] ) ) )
		formatString: #,0
		lineageTag: 6a3a37770886cdea1326400f363c8624

	/// Estimated unit cost times quantity, on matched product keys only.
	measure 'Estimated Total Cost (Matched Product IDs)' = SUMX ( FILTER ( Fact_Sales, NOT ISBLANK ( RELATED ( Dim_Product[Cost] ) ) ), Fact_Sales[Quantity] * RELATED ( Dim_Product[Cost] ) )
		formatString: #,0.00 "EGP"
		lineageTag: 5286b108794e532a9c10ef2602cc0f3b

	measure 'Gross Sales (Matched Product IDs)' = CALCULATE ( [Gross Sales Before Discount & Tax], FILTER ( Fact_Sales, NOT ISBLANK ( RELATED ( Dim_Product[Cost] ) ) ) )
		formatString: #,0.00 "EGP"
		lineageTag: c75350aa0030b3173e37d6220417a82c

	/// Estimated gross profit on matched product-cost sales only; not company net profit.
	measure 'Estimated Gross Profit (Matched Product IDs)' = [Gross Sales (Matched Product IDs)] - [Estimated Total Cost (Matched Product IDs)]
		formatString: #,0.00 "EGP"
		lineageTag: f1c0f7a58ed657546dd6be2eb243239b

	/// Estimated gross profit margin on matched product-cost sales only.
	measure 'Estimated Gross Profit Margin (Matched Product IDs)' = DIVIDE ( [Estimated Gross Profit (Matched Product IDs)], [Gross Sales (Matched Product IDs)] )
		formatString: 0.0%
		lineageTag: e18307644b74d00c11c622e86a52cabe

	measure 'Top 10 Product Gross Sales' = IF ( RANKX ( ALLSELECTED ( Dim_Product[ProductName] ), [Gross Sales Before Discount & Tax], , DESC, DENSE ) <= 10, [Gross Sales Before Discount & Tax] )
		formatString: #,0.00 "EGP"
		lineageTag: 4131e620035bb1066e43cdf607664e19

	measure 'Top 10 Product Estimated Gross Profit' = IF ( RANKX ( ALLSELECTED ( Dim_Product[ProductName] ), [Estimated Gross Profit (Matched Product IDs)], , DESC, DENSE ) <= 10, [Estimated Gross Profit (Matched Product IDs)] )
		formatString: #,0.00 "EGP"
		lineageTag: 42c108ee2d9831a5d32f2539fe222d02

